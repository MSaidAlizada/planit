# Copy this file to .env and fill in the values.

# Database (default works for local dev; Docker overrides this automatically)
DATABASE_URL=sqlite:///./planit.db

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30

# CORS — set to your actual domain in production
# Local dev: the default ["http://localhost:3000"] is fine
CORS_ORIGINS=["https://your-pi-hostname-or-ip"]

# Google Calendar OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-pi-hostname-or-ip/auth/google/callback
FRONTEND_URL=https://your-pi-hostname-or-ip
