# Copy this file to .env and fill in the values.

# Database (default works for local dev; Docker overrides this automatically)
DATABASE_URL=sqlite:///./planit.db

# Set to "production" once deployed — disables insecure OAuth transport and
# a couple of dev-only defaults.
ENVIRONMENT=development

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — the exact origin(s) the frontend is served from (no path, no trailing slash).
# Local dev: the default ["http://localhost:3000"] is fine.
# Split deployment (e.g. GitHub Pages frontend): ["https://your-username.github.io"]
CORS_ORIGINS=["https://your-pi-hostname-or-ip"]

# Google Calendar OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be reachable by the browser doing the OAuth redirect — the backend's
# own public URL (e.g. a Tailscale Funnel hostname), not the frontend's.
GOOGLE_REDIRECT_URI=https://your-backend-public-url/auth/google/callback
# Where users land after connecting Google Calendar — the frontend's URL,
# including any subpath (e.g. https://your-username.github.io/planit).
FRONTEND_URL=https://your-frontend-url

# Registration — first user to register becomes admin and needs no invite
# code; everyone after that needs a code an admin issued via POST /api/auth/invites.
# REGISTRATION_REQUIRES_INVITE=true
